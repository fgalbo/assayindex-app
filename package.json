{
  "name": "assayindex",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "A source-transparent index of reference laboratory tests and validated discovery data.",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "predev": "npm run sync:assayindex-catalog",
    "prebuild": "npm run sync:assayindex-catalog",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "verify:public-export": "node ./scripts/verify-public-export.mjs",
    "test:assayindex-acquisition": "node --test ./tests/assayindex/acquisition-node.node.mjs",
    "sync:assayindex-catalog": "node ./scripts/sync-assayindex-catalog.mjs",
    "generate:assayindex-downloads": "node ./scripts/generate-assayindex-downloads.mjs",
    "publish:assayindex-catalog:blob": "node ./scripts/publish-assayindex-catalog-blob.mjs",
    "acquire:assayindex": "node ./scripts/acquire-assayindex.mjs",
    "promote:assayindex-source": "node ./scripts/promote-assayindex-source.mjs",
    "update:assayindex-sources": "node ./scripts/update-assayindex-sources.mjs",
    "review:assayindex": "node ./scripts/review-assayindex-candidates.mjs",
    "generate:assayindex-gtr-search": "node ./scripts/generate-assayindex-gtr-search.mjs",
    "publish:assayindex-gtr-search": "node ./scripts/publish-assayindex-gtr-search-blob.mjs"
  },
  "dependencies": {
    "@vercel/blob": "^2.3.3",
    "docx": "^9.5.1",
    "fuse.js": "^7.1.0",
    "idb-keyval": "^6.2.2",
    "next": "16.4.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "undici": "6.29.1"
  }
}
