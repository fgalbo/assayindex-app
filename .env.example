# Optional runtime catalog source. When set, AssayIndex tries this URL before
# falling back to the local /assayindex/catalog.json snapshot.
NEXT_PUBLIC_ASSAYINDEX_CATALOG_URL=

# Required only for publishing the catalog to Vercel Blob.
BLOB_READ_WRITE_TOKEN=

# Optional Vercel Blob publish settings.
ASSAYINDEX_BLOB_PATH=assayindex/catalog.json
ASSAYINDEX_BLOB_CACHE_MAX_AGE=60

# Server-only validated NIH GTR testing-search artifact. Keep the Blob private.
ASSAYINDEX_GTR_READ_WRITE_TOKEN=
ASSAYINDEX_GTR_TESTING_MANIFEST_BLOB_PATH=assayindex/testing/gtr/latest.json

# Server-only federated laboratory directory search. Live source access is
# disabled unless both the master flag and the source flag are explicitly true.
ASSAYINDEX_FEDERATED_SEARCH_ENABLED=false
ASSAYINDEX_AUTO_EXTERNAL_FALLBACK_ENABLED=false
ASSAYINDEX_ARUP_SEARCH_ENABLED=false
ASSAYINDEX_SOURCE_SEARCH_CACHE_TTL_SECONDS=86400
ASSAYINDEX_SOURCE_REQUEST_TIMEOUT_MS=20000
